<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Phase 1A manifest: minimal production surface so the app installs,
      launches, and shows the Flutter engine. App-lock specific declarations
      (PACKAGE_USAGE_STATS, SYSTEM_ALERT_WINDOW, BIND_ACCESSIBILITY_SERVICE,
      Device Admin receiver, QUERY_ALL_PACKAGES / <queries>) are added in the
      phases that implement those features.

      allowBackup=false (Phase 1F): sensitive values are protected by the
      Android Keystore, and Keystore keys do NOT survive a backup/restore to
      a new device. Restoring encrypted data without its key would corrupt
      the vault, so cloud backups are disabled for this app.
    -->
    <!-- Phase 2J: required to use biometric authentication (BiometricPrompt)
         on Android 9 and lower; harmless on newer versions. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Phase 3A: package visibility (Android 11+). Declaring the launcher
         intent lets us discover launchable apps for App Lock selection
         without the broad QUERY_ALL_PACKAGES permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="Smart App Lock"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

</manifest>
