<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Phase 1A manifest: minimal production surface so the app installs,
      launches, and shows the Flutter engine. App-lock specific declarations
      (PACKAGE_USAGE_STATS, SYSTEM_ALERT_WINDOW, BIND_ACCESSIBILITY_SERVICE,
      Device Admin receiver, QUERY_ALL_PACKAGES / <queries>) are added in the
      phases that implement those features.

      allowBackup=false (Phase 1F): sensitive values are protected by the
      Android Keystore, and Keystore keys do NOT survive a backup/restore to
      a new device. Restoring encrypted data without its key would corrupt
      the vault, so cloud backups are disabled for this app.
    -->
    <!-- Phase 2J: required to use biometric authentication (BiometricPrompt)
         on Android 9 and lower; harmless on newer versions. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Phase 4B (device-QA fix): PACKAGE_USAGE_STATS list membership.
         The GRANT is still made exclusively through the system Usage Access
         settings screen (AppOps OPSTR_GET_USAGE_STATS) — this declaration
         cannot grant anything. But Android's Usage Access screen only lists
         apps that REQUEST the permission in their manifest (and the
         UsageStatsManager API docs require the declaration), so without it
         Smart App Lock never appears in the list and the user cannot grant
         it. tools:ignore silences the ProtectedPermissions lint for this
         special appop permission. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Required presentation capability. A short-lived opaque
         TYPE_APPLICATION_OVERLAY shield blocks interaction while the
         activity-hosted PIN/pattern/biometric challenge is starting or the
         Flutter engine is recovering. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Native recovery watcher for background detection and challenge
         reconstruction after Dart isolate/process loss. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- API 33+: shows the watcher notification. The service runs even
         without it (the notification is simply hidden). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Restarts previously configured protection after an unlocked boot.
         No credential data is read by the receiver. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Phase 3A: package visibility (Android 11+). Declaring the launcher
         intent lets us discover launchable apps for App Lock selection
         without the broad QUERY_ALL_PACKAGES permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="Smart App Lock"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Phase 4C: detection-only accessibility service (fallback
             foreground detection). Restricted to window-state events with
             content capture disabled — see res/xml/accessibility_service_config.xml. -->
        <service
            android:name=".AccessibilityLockService"
            android:exported="false"
            android:label="Smart App Lock detection"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Phase 5 recovery watcher: detects protected apps after a Dart
             isolate/process loss and keeps the native shield active while
             Flutter authentication is reconstructed. -->
        <service
            android:name=".WatcherService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps foreground detection alive while Smart App Lock is backgrounded so protected apps are locked the moment they open." />
        </service>

        <receiver
            android:name=".ProtectionBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
